# Nexora Commerce — copy to .env and fill in. Never commit .env.
# Database: Supabase Postgres connection string (direct, port 5432).
# In Supabase: Project settings → Database → Connection string → URI.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.xxxxx.supabase.co:5432/postgres"

# Session secret: at least 32 random characters.
# Generate: openssl rand -hex 32
SESSION_SECRET="REPLACE_WITH_32_PLUS_RANDOM_CHARS"

# First admin account, created by the seed (optional; used once):
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="a-strong-password"

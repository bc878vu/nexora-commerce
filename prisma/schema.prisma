datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  ADMIN
  INVENTORY_MANAGER
}

enum OrderStatus {
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum StockChangeReason {
  INITIAL_SEED
  PURCHASE_ORDER_RESTOCK
  CUSTOMER_CHECKOUT
  ORDER_CANCELLATION
  MANUAL_AUDIT
  DAMAGED_WRITE_OFF
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  role      Role      @default(CUSTOMER)
  orders    Order[]
  addresses Address[]
  createdAt DateTime  @default(now())
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id])
  label      String
  street     String
  city       String
  postalCode String
  country    String
  isDefault  Boolean @default(false)
}

model Product {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  category    String
  description String
  basePrice   Decimal          @db.Decimal(10, 2)
  variants    ProductVariant[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ProductVariant {
  id             String           @id @default(cuid())
  sku            String           @unique
  productId      String
  product        Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributes     Json             // e.g. {"color": "Obsidian Black", "option": "ANC Pro"}
  unitCost       Decimal          @db.Decimal(10, 2)
  retailPrice    Decimal          @db.Decimal(10, 2)
  onHandStock    Int              @default(0)
  reservedStock  Int              @default(0)
  reorderPoint   Int              @default(10)
  warehouseBin   String           @default("WH-A1-01")
  ledgerEntries  StockLedger[]
  orderItems     OrderItem[]
  updatedAt      DateTime         @updatedAt

  @@index([sku])
  @@index([productId])
}

model StockLedger {
  id          String            @id @default(cuid())
  variantId   String
  variant     ProductVariant    @relation(fields: [variantId], references: [id])
  delta       Int               // Positive for restock/return, negative for checkout/write-off
  balanceAfter Int
  reason      StockChangeReason
  note        String?
  actorName   String
  createdAt   DateTime          @default(now())
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  status          OrderStatus @default(PROCESSING)
  totalAmount     Decimal     @db.Decimal(10, 2)
  shippingAddress String
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  sku       String
  quantity  Int
  unitPrice Decimal        @db.Decimal(10, 2)
}

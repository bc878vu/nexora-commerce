    "zod": "3.25.76",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "6.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
